{
  // Upswing SolSignal — Dual-Rail Solana Token Safety & Microstructure Signal API
  // $0-infra Cloudflare Workers Free Tier (100k req/day, zero paid add-ons, zero edge secrets)
  "name": "upswing-solsignal",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    // Public deposit-only Solana USDC payout recipient (ZERO private keys on edge)
    "PAYOUT_SOLANA_WALLET": "9kE6pAKgW1M2J27JAX7bMkY2uGanjNGjxzrNpomA6bte",
    "USDC_SOLANA_MINT": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    // 0.005 USDC = 5000 micro-USDC (6 decimals)
    "PRO_PRICE_MICRO_USDC": "5000",
    // PayAI x402 Facilitator (zero API key needed on shared Solana exact lane)
    "X402_FACILITATOR_URL": "https://facilitator.payai.network",
    // Verified live from https://facilitator.payai.network/supported (solana + CAIP-2 exact feePayer)
    "X402_FEE_PAYER": "CjNFTjvBhbJJd2B5ePPMHRLx1ELZpa8dwQgGL727eKww",
    // Fallback direct Solana RPC for confirmed X-PAYMENT-TX verification
    "SOLANA_RPC_URL": "https://api.mainnet-beta.solana.com",
    "FREE_RATE_LIMIT_PER_MINUTE": "15",
    "SIGNAL_CACHE_TTL_SECONDS": "60",
    // Optional: set custom public origin (defaults to incoming request origin if empty)
    "PUBLIC_BASE_URL": "",
    // Optional: Owner one-time Farcaster Mini-App domain association fields
    "FARCASTER_HEADER": "",
    "FARCASTER_PAYLOAD": "",
    "FARCASTER_SIGNATURE": ""
  }
}
